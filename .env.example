# Required. Never commit the populated .env file.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=123456789012345678
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

# Summary model and bounded workload settings.
OPENAI_MODEL=gpt-5.5
SUMMARY_CHUNK_CHARS=30000
MAX_TRANSCRIPT_CHARS=1500000

# Optional podcast metadata providers. Apple Podcasts and direct RSS need no key.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Optional YouTube proxy. Generic proxies use the fields as-is. IPRoyal adds a
# fresh session tag per job without ever logging the resulting credential.
YOUTUBE_PROXY_ENABLED=false
YOUTUBE_PROXY_PROVIDER=generic
YOUTUBE_PROXY_PROTOCOL=http
YOUTUBE_PROXY_HOST=
YOUTUBE_PROXY_PORT=
YOUTUBE_PROXY_USERNAME=
YOUTUBE_PROXY_PASSWORD=
YOUTUBE_PROXY_COUNTRY=us
YOUTUBE_PROXY_SESSION_LIFETIME=10m

# Disabled by default to avoid leaking the host's direct IP if a proxy fails.
YOUTUBE_ALLOW_DIRECT_FALLBACK=false

# Optional Netscape-format YouTube cookies mounted outside the repository.
YOUTUBE_COOKIES_FILE=

# Safety and resource bounds.
MAX_CONCURRENT_JOBS=1
MAX_ATTACHMENT_BYTES=524288000
MAX_REMOTE_MEDIA_BYTES=536870912
MAX_METADATA_BYTES=10485760
MAX_MEDIA_DURATION_SECONDS=21600
REMOTE_REQUEST_TIMEOUT_SECONDS=30
REMOTE_MAX_REDIRECTS=5
LOG_LEVEL=INFO
